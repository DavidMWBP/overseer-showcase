# Copy to `.env` (never committed) at the repository root. Read by the daemon (packages/daemon/src/index.ts) and the web
# server (packages/web/vite.config.ts) at start; a variable already set in the shell wins. Every variable is optional.

# Web port and hostnames the web server accepts besides localhost, comma-separated: a Tailscale name for the phone, a LAN name.
#OVERSEER_WEB_PORT=5173
OVERSEER_WEB_HOSTS=

# Daemon port and data directory (database, worktrees, session logs). The web dev server's /api proxy follows the port too.
#OVERSEER_PORT=4400
#OVERSEER_DATA_DIR=

# Minutes of inactivity after which the next message starts a fresh orchestrator session.
#OVERSEER_ORCHESTRATOR_IDLE_MIN=30

# Minutes of silence after which a running worker or critic is reported to the orchestrator as stalled. 0 turns it off.
#OVERSEER_STALL_MIN=15

# Minutes a worker is left idling after a turn end with a non-empty final message before the session is ended cleanly. 0 turns it off.
#OVERSEER_IDLE_END_MIN=3

# Minutes between passes that kill processes left in worktrees with no running session (first pass at startup). 0 turns it off.
#OVERSEER_REAP_MIN=5

# Days after a session ends before the nightly job deletes its events and session log. The session row, cost and token counts stay.
#OVERSEER_RETENTION_DAYS=14

# Claude OAuth usage threshold. Each other running session on the account subtracts the per-session reserve, with a floor of half this value. A blank, negative or non-finite reserve falls back to 2; 0 is valid.
#OVERSEER_USAGE_THRESHOLD=95

# Percentage points to reserve for each running session on the account.
#OVERSEER_USAGE_RESERVE_PER_SESSION=2

# VAPID subject sent to the push services (a mailto: or https: URL identifying you as the sender). Apple rejects
# addresses on localhost; the default is mailto:overseer@example.com.
#OVERSEER_PUSH_SUBJECT=

# Binaries, when they are not on PATH under their default names.
#OVERSEER_BD=bd
#OVERSEER_CLAUDE=claude
#OVERSEER_CODEX=codex
#OVERSEER_OPENCODE=opencode
#OVERSEER_GLAB=glab
